<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Dominoes · LAN Multiplayer</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🁠</text></svg>">
<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
:root{--gold:#e8b93a;--gold-dark:#b8860b;--cream:#f2efe6;--green:#0d6f45;--panel:rgba(0,0,0,.28)}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:system-ui,"Segoe UI",sans-serif;background:linear-gradient(160deg,#000,#141414 60%);color:var(--cream)}
button,input{font:inherit}button{cursor:pointer}button:disabled{opacity:.45;cursor:not-allowed}
#app{min-height:100vh}.setup-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px}.setup-screen.hidden,.game-screen.hidden{display:none!important}
.screen{width:100%;max-width:520px;display:flex;flex-direction:column;gap:14px;margin:auto}h1{text-align:center;color:var(--gold);margin:0;font-size:1.7rem}.subtitle{text-align:center;opacity:.85;margin:0 0 12px}
.panel{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:16px;padding:16px}label{display:block;font-size:.9rem;margin-bottom:7px}input[type=text]{width:100%;padding:12px;border-radius:10px;border:1px solid #555;background:#1e1e1e;color:white}
.chip-row{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}.chip{padding:8px 14px;border-radius:20px;border:1px solid #666;background:#ffffff0d;color:var(--cream);cursor:pointer}.chip.active{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:#000;font-weight:700}
button.primary,.action-btn{padding:12px 15px;border:0;border-radius:10px;background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:#111;font-weight:700}.primary{width:100%;margin-top:10px}.secondary{padding:10px 14px;border:1px solid #62806e;border-radius:10px;background:#315b48;color:#fff;font-weight:600}
#qrCode{display:flex;justify-content:center;margin:14px 0}.join-code{text-align:center;font:700 1.7rem monospace;letter-spacing:2px;color:var(--gold);margin:8px}.players-waiting{background:#0005;border-radius:10px;padding:10px;margin:12px 0;min-height:42px}.waiting-player{padding:7px 10px;margin:4px 0;background:#ffffff12;border-radius:7px}
.game-screen{min-height:100vh;display:flex;flex-direction:column;gap:12px;padding:12px;background:linear-gradient(135deg,var(--green),#0d5038)}
.top-bar,.players-section,.hand-area,.action-buttons{background:var(--panel);border-radius:10px;padding:12px}.top-bar{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.board-area{min-height:230px;display:flex;align-items:center;justify-content:center;overflow:auto;border-radius:12px;background:#0002;padding:12px}
#board{width:100%;min-height:190px;display:flex;flex-wrap:wrap;align-content:center;align-items:center;justify-content:center;gap:7px;padding:12px}
.empty{color:#d5e6dc;text-align:center;padding:24px}
.domino-played,.hand-domino{flex:0 0 auto;display:flex;flex-direction:column;position:relative;overflow:hidden;background:linear-gradient(135deg,#fffaf0,#e8dcc8);color:#222;border:2px solid #c8b8a0;box-shadow:0 4px 9px #0005}
.domino-played{width:42px;height:84px;border-radius:6px}.hand-domino{width:42px;height:84px;border-radius:6px;cursor:pointer;transition:transform .15s,border-color .15s}
.hand-domino:hover{transform:translateY(-5px);border-color:var(--gold)}.hand-domino.selected{outline:3px solid var(--gold);transform:translateY(-7px)}
.domino-played:after,.hand-domino:after{content:"";position:absolute;left:0;right:0;top:50%;height:1px;background:#aaa}
.domino-half-top,.domino-half-bottom{flex:1;display:flex;align-items:center;justify-content:center;line-height:1;font-size:13px;letter-spacing:-1px;overflow:hidden}
.players-section{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}.player-status{min-width:100px;padding:9px 11px;text-align:center;border:1px solid #ffffff22;border-radius:9px;background:#ffffff0c;font-size:.85rem}.player-status.current{border-color:var(--gold);background:#e8b93a22}
.hand-area{display:flex;flex-wrap:wrap;justify-content:center;align-content:flex-start;gap:8px;min-height:112px;padding:14px}
.action-buttons{display:flex;justify-content:center;flex-wrap:wrap;gap:9px}.message{text-align:center;min-height:26px;color:#ffe6a5;font-weight:600}
#scoreBoard{width:100%;text-align:center;color:#d8e9df;font-size:.9rem;margin-bottom:8px}
@media(max-width:500px){.game-screen{padding:7px}.board-area{min-height:190px;padding:5px}.domino-played{width:34px;height:68px}.hand-domino{width:39px;height:78px}.panel{padding:12px}}
</style>
</head>
<body>
<div id="app">
  <section id="setupScreen" class="setup-screen">
    <div class="screen">
      <h1>🁠 Dominoes</h1><p class="subtitle">Multiplayer over LAN / peer-to-peer</p>
      <div class="panel"><label for="playerName">Your name</label><input id="playerName" type="text" maxlength="24" value="Player" placeholder="Enter your name"></div>
      <div class="panel"><label>Game mode</label><div class="chip-row">
        <button class="chip active" id="hostModeBtn" type="button">Host game</button><button class="chip" id="joinModeBtn" type="button">Join game</button>
      </div></div>
      <div id="hostPanel" class="panel">
        <label>Players (including host)</label><div class="chip-row" id="playerChoices">
          <button class="chip active" data-players="2" type="button">2</button><button class="chip" data-players="3" type="button">3</button><button class="chip" data-players="4" type="button">4</button><button class="chip" data-players="5" type="button">5</button><button class="chip" data-players="6" type="button">6</button><button class="chip" data-players="7" type="button">7</button><button class="chip" data-players="8" type="button">8</button>
        </div>
        <div id="qrCode"></div><div class="join-code" id="gameCode">Connecting…</div>
        <div class="players-waiting" id="lobbyList">Opening host connection…</div>
        <button class="primary" id="startBtn" type="button" disabled>Start game</button>
        <p class="subtitle">The game starts when all selected seats are filled.</p>
      </div>
      <div id="joinPanel" class="panel" hidden>
        <label for="gameCodeInput">Game code</label><input id="gameCodeInput" type="text" placeholder="DOM-ABC123" maxlength="12" autocomplete="off">
        <button class="primary" id="joinGameBtn" type="button">Join game</button>
        <p class="subtitle" id="joinMessage"></p>
      </div>
    </div>
  </section>

  <section id="gameScreen" class="game-screen hidden">
    <div class="top-bar"><div>Turn: <strong id="currentPlayer">—</strong></div><div>Stock: <strong id="stockCount">0</strong></div><div>Set: <strong id="setCount">1</strong></div></div>
    <div class="board-area"><div id="board"><div class="empty">Waiting for the game…</div></div></div>
    <div class="action-buttons">
      <button id="leftBtn" class="secondary" type="button">Play selected on left</button>
      <button id="rightBtn" class="secondary" type="button">Play selected on right</button>
      <button id="drawBtn" class="action-btn" type="button">Draw tile</button>
      <button id="passBtn" class="secondary" type="button">Pass</button>
      <button id="leaveBtn" class="secondary" type="button">Leave game</button>
    </div>
    <div class="message" id="gameMessage" role="status" aria-live="polite"></div>
    <div id="playersList" class="players-section"></div>
    <div class="panel"><strong>Your hand</strong><div id="handArea" class="hand-area"></div></div>
    <div id="scoreBoard"></div>
  </section>
</div>

<script>
"use strict";
const STUN = { iceServers: [
  { urls: "stun:stun.l.google.com:19302" },
  { urls: "stun:stun1.l.google.com:19302" }
]};
const $ = id => document.getElementById(id);
let gameMode = "host", maxPlayers = 2, myName = "Player", gameCode = "";
let peer = null, hostConn = null, isHost = false, isJoining = false, game = null;
let clientConns = new Map(), myIndex = 0, selectedTileId = null;
let hostReady = false, gameStarted = false, messageText = "", peerGeneration = 0;

function safeName(value) {
  const name = String(value || "").trim().replace(/[<>]/g, "").slice(0, 24);
  return name || "Player";
}
function setMessage(text) { messageText = text; $("gameMessage").textContent = text; }
function randomCode() { return "DOM-" + Math.random().toString(36).slice(2, 8).toUpperCase(); }
function setMode(mode) {
  gameMode = mode;
  $("hostModeBtn").classList.toggle("active", mode === "host");
  $("joinModeBtn").classList.toggle("active", mode === "join");
  $("hostPanel").hidden = mode !== "host";
  $("joinPanel").hidden = mode !== "join";
  if (mode === "host" && !hostReady) initHost();
}
function setPlayers(n) {
  if (gameStarted) return;
  maxPlayers = n;
  document.querySelectorAll("[data-players]").forEach(b => b.classList.toggle("active", Number(b.dataset.players) === n));
  updateLobby();
}
function cleanupPeer() {
  peerGeneration++;
  try { if (hostConn) hostConn.close(); } catch {}
  try { if (peer) peer.destroy(); } catch {}
  peer = null; hostConn = null; clientConns.clear(); hostReady = false;
}
function initHost() {
  if (peer && isHost && hostReady) return;
  cleanupPeer();
  isHost = true; gameStarted = false;
  gameCode = randomCode();
  const generation = peerGeneration;
  $("gameCode").textContent = gameCode;
  $("qrCode").replaceChildren();
  const joinUrl = new URL(window.location.href);
  joinUrl.searchParams.set("join", gameCode);
  if (window.QRCode) new QRCode($("qrCode"), { text: joinUrl.toString(), width: 150, height: 150 });
  $("lobbyList").textContent = "Opening host connection…";
  $("startBtn").disabled = true;
  const peerId = gameCode.replace(/-/g, "").toLowerCase();
  try { peer = new Peer(peerId, { config: STUN }); }
  catch (e) { $("lobbyList").textContent = "Could not create PeerJS connection: " + e.message; return; }
  peer.on("open", () => {
    if (generation !== peerGeneration) return;
    hostReady = true;
    $("gameCode").textContent = gameCode;
    updateLobby();
  });
  peer.on("connection", conn => {
    if (generation !== peerGeneration) { conn.close(); return; }
    conn.on("open", () => {});
    conn.on("data", msg => handleHostMessage(conn, msg));
    conn.on("close", () => {
      const entry = clientConns.get(conn.peer);
      if (entry) {
        clientConns.delete(conn.peer);
        if (game && entry.index != null && game.players[entry.index]) {
          game.players[entry.index].connected = false;
          broadcastState("A player disconnected.");
        } else updateLobby();
      }
    });
    conn.on("error", err => console.warn("Peer connection error", err));
  });
  peer.on("error", err => {
    console.error(err);
    if (generation === peerGeneration) {
      hostReady = false;
      $("lobbyList").textContent = "Peer connection error: " + (err.type || err.message || "unknown error") + ". Try hosting again.";
    }
  });
}
function updateLobby() {
  if (gameStarted || gameMode !== "host") return;
  const entries = [...clientConns.values()].filter(c => c.name && c.conn.open);
  const names = [myName, ...entries.map(c => c.name)];
  $("lobbyList").innerHTML = "";
  names.forEach((name, i) => {
    const div = document.createElement("div"); div.className = "waiting-player";
    div.textContent = `${i === 0 ? "★ " : ""}${name}${i === 0 ? " (host)" : ""}`;
    $("lobbyList").append(div);
  });
  const missing = maxPlayers - names.length;
  if (missing > 0) {
    const div = document.createElement("div"); div.className = "waiting-player";
    div.textContent = `Waiting for ${missing} more player${missing === 1 ? "" : "s"}…`;
    $("lobbyList").append(div);
  }
  $("startBtn").disabled = !hostReady || names.length !== maxPlayers;
}
function handleHostMessage(conn, msg) {
  if (!msg || typeof msg !== "object") return;
  if (msg.type === "join") {
    if (gameStarted) { conn.send({ type: "reject", reason: "This game has already started." }); conn.close(); return; }
    const existing = clientConns.get(conn.peer);
    if (existing && existing.index != null) return;
    const connected = [...clientConns.values()].filter(c => c.name && c.conn.open);
    if (connected.length >= maxPlayers - 1) { conn.send({ type: "reject", reason: "The lobby is full." }); conn.close(); return; }
    const name = safeName(msg.name);
    clientConns.set(conn.peer, { conn, name, index: null });
    updateLobby();
    conn.send({ type: "lobby", names: [myName, ...[...clientConns.values()].filter(c=>c.name).map(c=>c.name)], maxPlayers });
    return;
  }
  const entry = clientConns.get(conn.peer);
  if (!entry || entry.index == null || !game || !gameStarted) return;
  if (msg.type === "play") hostAction(entry.index, { type: "play", tileId: msg.tileId, side: msg.side });
  else if (msg.type === "draw") hostAction(entry.index, { type: "draw" });
  else if (msg.type === "pass") hostAction(entry.index, { type: "pass" });
}
function makeTile(a, b, copy) { return { id: `${copy}-${a}-${b}-${Math.random().toString(36).slice(2,9)}`, a, b }; }
function createGame(n) {
  const copies = n > 4 ? 2 : 1;
  const tiles = [];
  for (let copy = 0; copy < copies; copy++)
    for (let a = 0; a <= 6; a++)
      for (let b = a; b <= 6; b++) tiles.push(makeTile(a, b, copy));
  for (let i = tiles.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [tiles[i], tiles[j]] = [tiles[j], tiles[i]];
  }
  const players = Array.from({length:n}, (_, i) => ({
    id: `p${i}`, name: i === 0 ? myName : "", hand: [], connected: i === 0
  }));
  players.forEach((p, i) => {
    if (i === 0) p.name = myName;
    else {
      const ent = [...clientConns.values()].find(c => c.index === i);
      p.name = ent ? ent.name : `Player ${i + 1}`;
      p.connected = !!(ent && ent.conn.open);
    }
    for (let k = 0; k < 7; k++) p.hand.push(tiles.pop());
  });
  return { players, stock: tiles, played: [], current: 0, setCount: copies, passCount: 0, finished: false, winner: null, scores: Array(n).fill(0), revision: 0 };
}
function startGame() {
  if (!isHost || !hostReady || gameStarted) return;
  const entries = [...clientConns.values()].filter(c => c.name && c.conn.open);
  if (entries.length !== maxPlayers - 1) { updateLobby(); return; }
  entries.forEach((entry, i) => { entry.index = i + 1; });
  myName = safeName($("playerName").value);
  game = createGame(maxPlayers);
  game.players[0].name = myName;
  gameStarted = true;
  $("setupScreen").classList.add("hidden");
  $("gameScreen").classList.remove("hidden");
  setMessage("Game started. Any tile can start the chain.");
  broadcastState();
}
function gameStateFor(index) {
  return {
    players: game.players.map((p, i) => ({
      id: p.id, name: p.name, hand: i === index ? p.hand : undefined,
      handCount: p.hand.length, connected: p.connected
    })),
    myHand: game.players[index].hand,
    played: game.played, stockCount: game.stock.length, current: game.current,
    setCount: game.setCount, passCount: game.passCount, finished: game.finished,
    winner: game.winner, scores: game.scores, revision: game.revision
  };
}
function broadcastState(note = "") {
  if (!game) return;
  game.revision++;
  renderHost();
  for (const entry of clientConns.values()) {
    if (entry.index != null && entry.conn.open) {
      try { entry.conn.send({ type: "state", state: gameStateFor(entry.index), note }); } catch(e) { console.warn(e); }
    }
  }
}
function loadClientState(s, note) {
  game = {
    players: s.players, myHand: s.myHand || [], played: s.played || [],
    stock: Array(s.stockCount || 0), current: s.current, setCount: s.setCount,
    passCount: s.passCount, finished: s.finished, winner: s.winner, scores: s.scores,
    revision: s.revision
  };
  renderClient();
  if (note) setMessage(note);
}
function currentEnds() {
  if (!game.played.length) return null;
  return { left: game.played[0][0], right: game.played[game.played.length - 1][1] };
}
function canPlay(tile) {
  if (!game || !game.played.length) return true;
  const ends = currentEnds();
  return tile.a === ends.left || tile.b === ends.left || tile.a === ends.right || tile.b === ends.right;
}
function applyPlay(playerIndex, tileId, side) {
  const player = game.players[playerIndex];
  if (!player) return "Unknown player.";
  const tileIndex = player.hand.findIndex(t => t.id === tileId);
  if (tileIndex < 0) return "That tile is not in your hand.";
  const tile = player.hand[tileIndex];
  if (!canPlay(tile)) return "That tile does not match either open end.";
  if (!game.played.length) {
    game.played.push([tile.a, tile.b]);
  } else {
    const ends = currentEnds();
    if (side === "left") {
      if (tile.b === ends.left) game.played.unshift([tile.a, tile.b]);
      else if (tile.a === ends.left) game.played.unshift([tile.b, tile.a]);
      else return "That tile cannot be played on the left.";
    } else {
      if (tile.a === ends.right) game.played.push([tile.a, tile.b]);
      else if (tile.b === ends.right) game.played.push([tile.b, tile.a]);
      else return "That tile cannot be played on the right.";
    }
  }
  player.hand.splice(tileIndex, 1);
  game.passCount = 0;
  if (player.hand.length === 0) {
    game.finished = true; game.winner = playerIndex;
    game.scores[playerIndex] = (game.scores[playerIndex] || 0) + game.players.reduce((sum, p, i) => sum + (i === playerIndex ? 0 : p.hand.reduce((a,t)=>a+t.a+t.b,0)), 0);
  } else game.current = (game.current + 1) % game.players.length;
  return "";
}
function hostAction(index, action) {
  if (!isHost || !game || !gameStarted || game.finished) return;
  if (index !== game.current) { sendError(index, "It is not your turn."); return; }
  const player = game.players[index];
  let error = "";
  if (action.type === "play") {
    error = applyPlay(index, action.tileId, action.side);
  } else if (action.type === "draw") {
    if (player.hand.some(canPlay)) {
      error = "You already have a playable tile. Play it before drawing.";
    } else if (game.stock.length === 0) {
      error = "The stock is empty. Pass your turn.";
    } else {
      player.hand.push(game.stock.pop());
      const canPlayNow = player.hand.some(canPlay);
      if (canPlayNow) {
        // Keep the same player's turn: they must play a matching tile now.
        game.passCount = 0;
        action.note = "You drew a playable tile. Play it to continue.";
      } else if (game.stock.length > 0) {
        // Still no match and tiles remain: player may draw again.
        action.note = "No match yet. Draw another tile.";
      } else {
        // Stock is empty and the final drawn tile is still unplayable: pass.
        game.passCount++;
        if (game.passCount >= game.players.length) {
          game.finished = true;
          const totals = game.players.map(p => p.hand.reduce((sum,t) => sum + t.a + t.b, 0));
          const min = Math.min(...totals);
          const winners = totals.map((v,i) => v === min ? i : -1).filter(i => i >= 0);
          game.winner = winners.length === 1 ? winners[0] : -1;
          if (game.winner >= 0) game.scores[game.winner] = (game.scores[game.winner] || 0) + totals.reduce((sum,v,i) => sum + (i === game.winner ? 0 : v), 0);
        } else {
          game.current = (game.current + 1) % game.players.length;
        }
      }
    }
  } else if (action.type === "pass") {
    if (game.stock.length) error = "Draw while the stock has tiles.";
    else if (player.hand.some(canPlay)) error = "You have a playable tile.";
    else {
      game.passCount++;
      if (game.passCount >= game.players.length) {
        game.finished = true; game.winner = -1;
        const totals = game.players.map(p => p.hand.reduce((sum,t)=>sum+t.a+t.b,0));
        const min = Math.min(...totals);
        const winners = totals.map((v,i)=>v===min?i:-1).filter(i=>i>=0);
        game.winner = winners.length === 1 ? winners[0] : -1;
        if (game.winner >= 0) game.scores[game.winner] = (game.scores[game.winner] || 0) + totals.reduce((sum,v,i)=>sum+(i===game.winner?0:v),0);
      } else game.current = (game.current + 1) % game.players.length;
    }
  }
  if (error) { sendError(index, error); return; }
  broadcastState(action.note || "");
}
function sendError(index, text) {
  if (index === 0) setMessage(text);
  else {
    const entry = [...clientConns.values()].find(c => c.index === index);
    if (entry && entry.conn.open) entry.conn.send({ type: "error", message: text });
  }
}
function localAction(action) {
  if (isHost) hostAction(0, action);
  else if (hostConn && hostConn.open) hostConn.send(action);
  else setMessage("Disconnected from host.");
}
function playSelected(side) {
  if (!game || game.finished || game.current !== myIndex || !selectedTileId) return;
  localAction({ type: "play", tileId: selectedTileId, side });
  selectedTileId = null;
}
function drawTile() {
  if (!game || game.finished || game.current !== myIndex) return;
  localAction({ type: "draw" });
}
function passTurn() {
  if (!game || game.finished || game.current !== myIndex) return;
  localAction({ type: "pass" });
}
function renderBoard() {
  const board = $("board"); board.replaceChildren();
  if (!game.played.length) {
    const div = document.createElement("div"); div.className = "empty"; div.textContent = "Select any tile to start the chain."; board.append(div); return;
  }
  game.played.forEach(d => {
    const el = document.createElement("div"); el.className = "domino-played";
    const top = document.createElement("div"); top.className = "domino-half-top"; top.textContent = dots(d[0]);
    const bottom = document.createElement("div"); bottom.className = "domino-half-bottom"; bottom.textContent = dots(d[1]);
    el.append(top,bottom); board.append(el);
  });
}
function dots(n) { return n === 0 ? "—" : "● ".repeat(n).trim(); }
function renderPlayers() {
  $("playersList").replaceChildren();
  game.players.forEach((p,i) => {
    const el = document.createElement("div"); el.className = "player-status" + (i === game.current ? " current" : "");
    el.textContent = `${i === myIndex ? "You · " : ""}${p.name || `Player ${i+1}`} (${p.handCount ?? p.hand?.length ?? 0})${p.connected === false ? " · offline" : ""}`;
    $("playersList").append(el);
  });
}
function renderHand() {
  const area = $("handArea"); area.replaceChildren();
  const hand = isHost ? (game.players[0]?.hand || []) : (game.myHand || []);
  hand.forEach(tile => {
    const el = document.createElement("button"); el.type = "button";
    el.className = "hand-domino" + (selectedTileId === tile.id ? " selected" : "");
    el.style.opacity = canPlay(tile) ? "1" : ".58";
    el.setAttribute("aria-label", `${tile.a} and ${tile.b}`);
    const top = document.createElement("div"); top.className = "domino-half-top"; top.textContent = dots(tile.a);
    const bottom = document.createElement("div"); bottom.className = "domino-half-bottom"; bottom.textContent = dots(tile.b);
    el.append(top,bottom);
    el.addEventListener("click", () => {
      if (game.current !== myIndex || game.finished) return;
      selectedTileId = selectedTileId === tile.id ? null : tile.id;
      render();
    });
    area.append(el);
  });
  if (!hand.length) {
    const empty = document.createElement("div"); empty.className = "empty"; empty.textContent = game.finished ? "Round finished." : "No tiles in your hand."; area.append(empty);
  }
}
function renderCommon() {
  renderBoard(); renderPlayers(); renderHand();
  $("currentPlayer").textContent = game.players[game.current]?.name || "—";
  $("stockCount").textContent = isHost ? game.stock.length : game.stockCount;
  $("setCount").textContent = game.setCount;
  const myTurn = !game.finished && game.current === myIndex;
  $("leftBtn").disabled = !myTurn || !selectedTileId || !game.played.length;
  $("rightBtn").disabled = !myTurn || !selectedTileId || !game.played.length;
  const myHand = isHost ? (game.players[myIndex]?.hand || []) : (game.myHand || []);
  const hasPlayable = myHand.some(canPlay);
  $("drawBtn").disabled = !myTurn || hasPlayable || !(isHost ? game.stock.length : game.stockCount);
  $("passBtn").disabled = !myTurn;
  $("scoreBoard").textContent = game.finished
    ? (game.winner === -1 ? "Round blocked: tie." : `${game.players[game.winner]?.name || "Player"} wins the round!`) +
      " Scores: " + game.players.map((p,i)=>`${p.name}: ${game.scores?.[i] || 0}`).join(" · ")
    : `Playing with ${game.setCount} set${game.setCount > 1 ? "s" : ""} · First to empty their hand wins.`;
}
function renderHost() { if (!game) return; renderCommon(); }
function renderClient() { if (!game) return; renderCommon(); }
function joinGame() {
  if (isJoining) return;
  myName = safeName($("playerName").value);
  const code = $("gameCodeInput").value.trim().toUpperCase();
  if (!/^DOM-[A-Z0-9]{4,8}$/.test(code)) { $("joinMessage").textContent = "Enter a valid code such as DOM-ABC123."; return; }
  isJoining = true; $("joinGameBtn").disabled = true; $("joinMessage").textContent = "Connecting to host…";
  cleanupPeer(); isHost = false; gameCode = code;
  const peerId = code.replace(/-/g, "").toLowerCase();
  const generation = peerGeneration;
  peer = new Peer({ config: STUN });
  peer.on("open", () => {
    if (generation !== peerGeneration) return;
    hostConn = peer.connect(peerId, { reliable: true });
    hostConn.on("open", () => {
      hostConn.send({ type: "join", name: myName });
      $("joinMessage").textContent = "Connected. Waiting for host to start…";
    });
    hostConn.on("data", msg => {
      if (!msg) return;
      if (msg.type === "reject") {
        $("joinMessage").textContent = msg.reason || "Join rejected.";
        isJoining = false; $("joinGameBtn").disabled = false; return;
      }
      if (msg.type === "lobby") {
        $("joinMessage").textContent = `In lobby (${msg.names.length}/${msg.maxPlayers}). Waiting for host…`;
      }
      if (msg.type === "start" || msg.type === "state") {
        myIndex = msg.index ?? myIndex;
        if (msg.type === "start") {
          myIndex = msg.index;
          $("setupScreen").classList.add("hidden"); $("gameScreen").classList.remove("hidden");
        }
        loadClientState(msg.state, msg.note || "");
      }
      if (msg.type === "error") setMessage(msg.message || "Move rejected.");
    });
    hostConn.on("close", () => { setMessage("Host connection closed. Return to the lobby and reconnect."); });
    hostConn.on("error", e => { $("joinMessage").textContent = "Connection error: " + (e.message || e.type); isJoining = false; $("joinGameBtn").disabled = false; });
  });
  peer.on("error", e => {
    console.error(e); $("joinMessage").textContent = "Peer error: " + (e.type || e.message || "connection failed");
    isJoining = false; $("joinGameBtn").disabled = false;
  });
}
function sendInitialStates() {
  for (const entry of clientConns.values()) {
    if (entry.index != null && entry.conn.open) {
      entry.conn.send({ type: "start", index: entry.index, state: gameStateFor(entry.index), note: "Game started." });
    }
  }
}
function leaveGame() {
  cleanupPeer(); game = null; gameStarted = false; isJoining = false; selectedTileId = null; myIndex = 0;
  $("setupScreen").classList.remove("hidden"); $("gameScreen").classList.add("hidden");
  $("joinGameBtn").disabled = false; $("joinMessage").textContent = "";
  if (gameMode === "host") initHost();
}
$("hostModeBtn").addEventListener("click", () => setMode("host"));
$("joinModeBtn").addEventListener("click", () => setMode("join"));
document.querySelectorAll("[data-players]").forEach(b => b.addEventListener("click", () => setPlayers(Number(b.dataset.players))));
$("startBtn").addEventListener("click", startGame);
$("joinGameBtn").addEventListener("click", joinGame);
$("leftBtn").addEventListener("click", () => playSelected("left"));
$("rightBtn").addEventListener("click", () => playSelected("right"));
$("drawBtn").addEventListener("click", drawTile);
$("passBtn").addEventListener("click", passTurn);
$("leaveBtn").addEventListener("click", leaveGame);
$("playerName").addEventListener("change", () => {
  myName = safeName($("playerName").value);
  if (isHost && !gameStarted) updateLobby();
});
/* Host receives join requests through each connection; after start, send each
   client its own private hand plus public counts. */
const originalStartGame = startGame;
startGame = function() {
  originalStartGame();
  if (gameStarted && game) sendInitialStates();
};
/* Patch host state sender to keep private hands private. */
const originalHandleHostMessage = handleHostMessage;
handleHostMessage = function(conn, msg) {
  if (msg && msg.type === "join") {
    if (gameStarted) { conn.send({type:"reject",reason:"Game already started."}); conn.close(); return; }
    const already = clientConns.get(conn.peer);
    if (already && already.name) return;
    const occupied = [...clientConns.values()].filter(c=>c.name && c.conn.open);
    if (occupied.length >= maxPlayers - 1) { conn.send({type:"reject",reason:"Lobby full."}); conn.close(); return; }
    const entry = { conn, name: safeName(msg.name), index: null };
    clientConns.set(conn.peer, entry);
    conn.send({type:"lobby",names:[myName,...occupied.map(c=>c.name),entry.name],maxPlayers});
    updateLobby();
    return;
  }
  const entry = clientConns.get(conn.peer);
  if (!entry || entry.index == null || !game || !gameStarted) return;
  if (msg?.type === "play") hostAction(entry.index, {type:"play",tileId:msg.tileId,side:msg.side});
  else if (msg?.type === "draw") hostAction(entry.index, {type:"draw"});
  else if (msg?.type === "pass") hostAction(entry.index, {type:"pass"});
};
const originalBroadcastState = broadcastState;
broadcastState = function(note = "") {
  if (!game) return;
  game.revision++;
  renderHost();
  for (const entry of clientConns.values()) {
    if (entry.index != null && entry.conn.open) {
      try { entry.conn.send({type:"state",index:entry.index,state:gameStateFor(entry.index),note}); } catch(e) { console.warn(e); }
    }
  }
};
/* QR auto-join support. */
const params = new URLSearchParams(location.search);
myName = safeName($("playerName").value);
if (params.has("join")) {
  $("gameCodeInput").value = params.get("join");
  setMode("join");
} else {
  setMode("host");
}
</script>
</body>
</html>